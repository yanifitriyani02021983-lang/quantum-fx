# =====================================================================
# 1. RISK-OF-RUIN CALCULATOR & STRESS TEST
# =====================================================================
class RiskManager:
    def __init__(self, initial_balance):
        self.balance = initial_balance

    def calculate_risk_of_ruin(self, win_rate, payoff_ratio, risk_per_trade_pct):
        """
        Menghitung persentase kebangkrutan berdasarkan formula ekspektasi matematis.
        payoff_ratio = Rata-rata Profit / Rata-rata Loss
        """
        if win_rate >= 1.0 or win_rate <= 0.0:
            return 0.0 if win_rate == 1.0 else 1.0
            
        q = 1.0 - win_rate
        p = win_rate
        # Perkiraan formula Kelly / Risk of Ruin
        # Untuk kepresisian tinggi, ini adalah proksi untuk eksponensial
        if p * payoff_ratio <= q:
            return 100.0 # Pasti hancur (Negative Expectancy)
            
        ruin_prob = ((q / p) ** (1 / risk_per_trade_pct)) * 100
        return min(ruin_prob, 100.0)

    def monte_carlo_simulation(self, historical_trades, num_simulations=100000, num_trades=100):
        """
        Simulasi Monte Carlo 100.000 skenario berdasarkan histori trading AI.
        Mengambil sampel acak dengan pengembalian untuk memprediksi probabilitas Drawdown.
        """
        print(f"Menjalankan {num_simulations} simulasi Monte Carlo...")
        simulated_end_balances = []
        max_drawdowns = []

        for _ in range(num_simulations):
            # Sampling acak dari histori (Bootstraping)
            sim_trades = np.random.choice(historical_trades, size=num_trades, replace=True)
            
            equity_curve = self.balance + np.cumsum(sim_trades)
            simulated_end_balances.append(equity_curve[-1])
            
            # Hitung Max Drawdown untuk simulasi ini
            peak = np.maximum.accumulate(equity_curve)
            drawdown = (peak - equity_curve) / peak
            max_drawdowns.append(np.max(drawdown) * 100)

        p95_drawdown = np.percentile(max_drawdowns, 95)
        median_balance = np.median(simulated_end_balances)
        
        return {
            "Simulated Median Balance": median_balance,
            "95% Confidence Max Drawdown": p95_drawdown
        }

    def run_stress_test(self):
        """
        Risk stress test 100.000 skenario dengan injeksi 'Black Swan' events 
        (contoh: Flash crash -500 pips dalam 1 detik).
        """
        print("Menjalankan Stress Test Pasar Ekstrem (Black Swan)...")
        # Logika: Mensimulasikan slippage drastis yang melewatkan Stop Loss
        simulated_loss = self.balance * 0.20 # Asumsi worst-case slippage kena 20% equity
        print(f"Equity setelah Black Swan Event: {self.balance - simulated_loss}")
        return True if simulated_loss < self.balance * 0.3 else False


# =====================================================================
# 2. SISTEM SEMI/AUTO TRADING KE METATRADER 5
# =====================================================================
class MT5ExecutionEngine:
    def __init__(self, login, password, server):
        self.login = login
        self.password = password
        self.server = server
        self.is_connected = False

    def connect(self):
        if not mt5.initialize():
            print("Gagal inisialisasi MT5, error code =", mt5.last_error())
            return False
            
        authorized = mt5.login(self.login, password=self.password, server=self.server)
        if authorized:
            self.is_connected = True
            print("Berhasil terkoneksi ke MT5 Terminal.")
        else:
            print("Gagal login ke akun MT5.")
        return authorized

    def fetch_data(self, symbol, timeframe, num_candles=500):
        """ Mengambil data OHLCV historis untuk feed ke AI """
        if not self.is_connected: return None
        
        rates = mt5.copy_rates_from_pos(symbol, timeframe, 0, num_candles)
        df = pd.DataFrame(rates)
        df['time'] = pd.to_datetime(df['time'], unit='s')
        return df

    def execute_trade(self, symbol, order_type, lot, price, sl, tp, ai_comment="AI_Auto"):
        """ Eksekusi order ke market """
        if not self.is_connected: return False

        mt5_order_type = mt5.ORDER_TYPE_BUY if order_type == "BUY" else mt5.ORDER_TYPE_SELL
        
        request = {
            "action": mt5.TRADE_ACTION_DEAL,
            "symbol": symbol,
            "volume": float(lot),
            "type": mt5_order_type,
            "price": float(price),
            "sl": float(sl),
            "tp": float(tp),
            "deviation": 20,
            "magic": 999111, # ID Unik untuk Bot AI ini
            "comment": ai_comment,
            "type_time": mt5.ORDER_TIME_GTC,
            "type_filling": mt5.ORDER_FILLING_IOC,
        }
        
        result = mt5.order_send(request)
        if result.retcode != mt5.TRADE_RETCODE_DONE:
            print(f"Gagal kirim order: {result.comment}")
            return False
            
        print(f"Sukses! Trade {order_type} dieksekusi pada {symbol}. Ticket: {result.order}")
        return True

    def shutdown(self):
        if self.is_connected:
            mt5.shutdown()
            print("Koneksi MT5 ditutup.")

