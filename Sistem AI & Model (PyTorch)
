# =====================================================================
# 1. MODEL LSTM + ATTENTION
# =====================================================================
class AttentionBlock(nn.Module):
    def __init__(self, hidden_dim):
        super(AttentionBlock, self).__init__()
        self.attention = nn.Linear(hidden_dim, 1)

    def forward(self, lstm_output):
        # lstm_output shape: (batch_size, seq_len, hidden_dim)
        attn_weights = torch.softmax(self.attention(lstm_output), dim=1)
        context_vector = torch.sum(attn_weights * lstm_output, dim=1)
        return context_vector, attn_weights

class LSTMAttentionNet(nn.Module):
    """
    AI belajar dari pola time-series. Attention fokus pada candle spesifik
    (misal: pinbar atau sweep liquidity) yang paling relevan.
    """
    def __init__(self, input_dim, hidden_dim, num_layers, output_dim, dropout=0.2):
        super(LSTMAttentionNet, self).__init__()
        self.lstm = nn.LSTM(input_dim, hidden_dim, num_layers, 
                            batch_first=True, dropout=dropout if num_layers > 1 else 0)
        self.attention = AttentionBlock(hidden_dim)
        self.fc1 = nn.Linear(hidden_dim, 64)
        self.relu = nn.ReLU()
        self.dropout = nn.Dropout(dropout)
        self.fc2 = nn.Linear(64, output_dim) # Output: Probabilitas Buy/Sell/Hold

    def forward(self, x):
        lstm_out, _ = self.lstm(x)
        context_vec, attn_weights = self.attention(lstm_out)
        out = self.fc1(context_vec)
        out = self.relu(out)
        out = self.dropout(out)
        out = self.fc2(out)
        return out

# =====================================================================
# 2. TRANSFORMER TIME SERIES
# =====================================================================
class PositionalEncoding(nn.Module):
    def __init__(self, d_model, max_len=5000):
        super(PositionalEncoding, self).__init__()
        pe = torch.zeros(max_len, d_model)
        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)
        div_term = torch.exp(torch.arange(0, d_model, 2).float() * (-math.log(10000.0) / d_model))
        pe[:, 0::2] = torch.sin(position * div_term)
        pe[:, 1::2] = torch.cos(position * div_term)
        self.register_buffer('pe', pe.unsqueeze(0))

    def forward(self, x):
        return x + self.pe[:, :x.size(1), :]

class TimeSeriesTransformer(nn.Module):
    """
    Menggunakan self-attention penuh untuk menangkap dependensi jangka panjang.
    Sangat bagus untuk analisis Orderflow & Struktur Market makro.
    """
    def __init__(self, feature_dim, d_model, nhead, num_layers, output_dim, dropout=0.1):
        super(TimeSeriesTransformer, self).__init__()
        self.input_projection = nn.Linear(feature_dim, d_model)
        self.pos_encoder = PositionalEncoding(d_model)
        encoder_layers = nn.TransformerEncoderLayer(d_model=d_model, nhead=nhead, dropout=dropout, batch_first=True)
        self.transformer_encoder = nn.TransformerEncoder(encoder_layers, num_layers=num_layers)
        self.decoder = nn.Linear(d_model, output_dim)

    def forward(self, src):
        src = self.input_projection(src)
        src = self.pos_encoder(src)
        output = self.transformer_encoder(src)
        # Ambil representasi dari timestep terakhir
        final_output = output[:, -1, :] 
        return self.decoder(final_output)

# =====================================================================
# 3. REINFORCEMENT LEARNING (RL) PROXY & DYNAMIC TP/SL
# =====================================================================
# Catatan: Dalam prakteknya menggunakan StableBaselines3 (PPO/SAC).
# Skrip ini mengilustrasikan fungsi Reward berbasis AI Optimasi.
class SmartTPSLOptimizer:
    def __init__(self, atr_multiplier=1.5):
        self.atr_multiplier = atr_multiplier
        
    def calculate_dynamic_levels(self, entry_price, current_atr, model_confidence, order_type):
        """
        AI Optimasi TP/SL: Jarak SL diatur oleh ATR.
        Jarak TP disesuaikan (adaptif) dengan tingkat konfidensi model AI.
        """
        sl_dist = current_atr * self.atr_multiplier
        
        # Jika AI sangat yakin (confidence > 0.8), perbesar rasio Risk:Reward menjadi 1:3
        # Jika biasa saja, Risk:Reward 1:1.5
        rr_ratio = 1.5 + (model_confidence * 1.5) 
        tp_dist = sl_dist * rr_ratio
        
        if order_type == 'BUY':
            return entry_price - sl_dist, entry_price + tp_dist
        else: # SELL
            return entry_price + sl_dist, entry_price - tp_dist

# =====================================================================
# 4. ENSEMBLE AI (LSTM + XGBoost) & SMART MONEY CONCEPT (SMC)
# =====================================================================
class EnsembleTradingAI:
    def __init__(self):
        self.xgb_model = xgb.XGBClassifier(n_estimators=100, learning_rate=0.05, max_depth=5)
        self.lstm_model = None # Di-load dari checkpoint
        self.scaler = StandardScaler()

    def train_weekly(self, X_train, y_train, dl_features_train):
        """
        AI Yang belajar otomatis tiap minggu.
        dl_features_train adalah probabilitas yang dihasilkan oleh LSTM/Transformer.
        XGBoost dilatih untuk menggabungkan fitur teknikal konvensional + prediksi DL.
        """
        X_scaled = self.scaler.fit_transform(X_train)
        # Meta-learning: Gabungkan input reguler dengan output LSTM
        X_meta = np.hstack((X_scaled, dl_features_train))
        self.xgb_model.fit(X_meta, y_train)
        print("Sistem berhasil melakukan Retraining Mingguan pada XGBoost Meta-Model.")

# =====================================================================
# 5. CRISIS DETECTOR (ANOMALY DETECTION SAAT HIGH IMPACT NEWS)
# =====================================================================
class MarketCrisisDetector:
    def __init__(self, contamination=0.01):
        # Isolation Forest mendeteksi outlayer (1% data paling ekstrem)
        self.model = IsolationForest(contamination=contamination, random_state=42)
        
    def train(self, historical_volatility_data):
        """ Melatih model untuk mengenali kondisi pasar 'Normal' """
        self.model.fit(historical_volatility_data)
        
    def is_market_safe(self, current_features):
        """
        Mendeteksi volatilitas abnormal / Spread melebar akibat NFP, CPI, Flash Crash.
        Returns False jika terdeteksi krisis (AI akan Hold trading).
        """
        prediction = self.model.predict(current_features)
        return prediction[0] == 1 # 1 is inlier (safe), -1 is outlier (crisis)

# =====================================================================
# SCRIPT TRAINING LSTM LENGKAP (ILUSTRASI)
# =====================================================================
def train_lstm_model(model, dataloader, criterion, optimizer, epochs=50):
    model.train()
    for epoch in range(epochs):
        epoch_loss = 0
        for X_batch, y_batch in dataloader:
            optimizer.zero_grad()
            outputs = model(X_batch)
            loss = criterion(outputs, y_batch)
            loss.backward()
            optimizer.step()
            epoch_loss += loss.item()
        
        if (epoch+1) % 10 == 0:
            print(f"Epoch {epoch+1}/{epochs}, Loss: {epoch_loss/len(dataloader):.4f}")
    
    # Save model untuk Github-Ready release
    torch.save(model.state_dict(), "lstm_attention_weights.pth")
    print("Training Selesai & Model Disimpan.")

